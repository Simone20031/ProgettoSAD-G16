<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicplayer.view.LibreriaView">
  <center>
    <SplitPane dividerPositions="0.22, 0.75" style="-fx-background-color: #000000; -fx-box-border: transparent; -fx-padding: 0;">
      <VBox maxWidth="300.0" minWidth="220.0" spacing="0" style="-fx-background-color: #000000; -fx-padding: 10 0 10 0;">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 16 20 20 20;">
          <Circle fill="#1DB954" radius="12"/>
          <Label style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Helvetica Neue';" text="SonicWave"/>
        </HBox>
        <VBox spacing="4" style="-fx-padding: 0 10 16 10;">
          <Button fx:id="btnMostraPiuAscoltati" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 16; -fx-cursor: hand; -fx-border-color: transparent;" text="🏠 Home Page"/>
          <Button fx:id="btnMostraLibreria" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: #1a1a1a; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 16; -fx-cursor: hand; -fx-border-color: transparent;" text="Libreria Generale"/>
        </VBox>
        <Region maxWidth="Infinity" prefHeight="1" style="-fx-background-color: #282828;">
          <VBox.margin>
            <Insets bottom="12" left="16" right="16"/>
          </VBox.margin>
        </Region>
        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4 20 8 20;">
          <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1.2px;" text="LE TUE PLAYLIST"/>
          <Pane HBox.hgrow="ALWAYS"/>
          <Button fx:id="btnApriCreazione" style="-fx-background-color: transparent; -fx-text-fill: #a7a7a7; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 0 5 0 0;" text="+">
            <tooltip>
              <Tooltip text="Crea nuova playlist"/>
            </tooltip>
          </Button>
        </HBox>
        <ListView fx:id="playlistListView" style="-fx-background-color: #000000; -fx-control-inner-background: #000000; -fx-border-color: transparent;" VBox.vgrow="ALWAYS"/>
      </VBox>
      <StackPane fx:id="contentStack">
        <VBox fx:id="viewLista" style="-fx-background-color: linear-gradient(to bottom, #112a1c 0%, #121212 40%);">
          <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
              <VBox>
                <HBox alignment="TOP_CENTER" style="-fx-padding: 24 24 16 24;">
                  <Label fx:id="mainTitleLabel" style="-fx-text-fill: #ffffff; -fx-font-size: 26px; -fx-font-weight: bold;" text="SonicWave"/>
                </HBox>
                <HBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 0 24 16 24;">
                  <Button fx:id="addBtn" alignment="TOP_CENTER" contentDisplay="CENTER" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-padding: 8 20; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand; -fx-border-color: transparent;" text="Importa MP3"/>
                  <Button fx:id="undoBtn" alignment="TOP_CENTER" contentDisplay="CENTER" disable="true" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-padding: 8 20; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: default; -fx-border-color: #555555; -fx-border-width: 1;" text="Annulla Ultima Operazione"/>
                </HBox>
                <HBox fx:id="playlistControlsBox" alignment="CENTER" spacing="16" style="-fx-padding: 0 24 16 24;">
                  <Button fx:id="playlistPlayBtn" alignment="CENTER" ellipsisString="" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-background-radius: 50%; -fx-min-width: 42; -fx-min-height: 42; -fx-max-width: 42; -fx-max-height: 42; -fx-cursor: hand;" text="▶" textAlignment="CENTER">
                    <font>
                      <Font size="18.0"/>
                    </font>
                  </Button>
                  <Button fx:id="playlistStopBtn" alignment="CENTER" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-font-size: 24px; -fx-cursor: hand;" text="⏹" textAlignment="CENTER">
                    <padding>
                      <Insets top="-4.0"/>
                    </padding>
                  </Button>
                  <Button fx:id="playlistShuffleBtn" alignment="CENTER" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-cursor: hand;" text="🔀" textAlignment="CENTER">
                    <font>
                      <Font size="18.0"/>
                    </font>
                  </Button>
                  <Button fx:id="playlistLoopBtn" alignment="CENTER" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-cursor: hand;" text="🔁" textAlignment="CENTER">
                    <font>
                      <Font size="19.0"/>
                    </font>
                  </Button>
                </HBox>
                <VBox spacing="10" style="-fx-padding: 0 24 16 24;">
                  <HBox alignment="CENTER_LEFT" spacing="8">
                    <TextField fx:id="searchTitoloField" prefWidth="120" promptText="Titolo..." style="-fx-background-color: #333333; -fx-text-fill: #ffffff;"/>
                    <TextField fx:id="searchAutoreField" prefWidth="120" promptText="Autore..." style="-fx-background-color: #333333; -fx-text-fill: #ffffff;"/>
                    <ComboBox fx:id="searchAnnoCombo" prefWidth="80" promptText="Anno" style="-fx-base: #333333;"/>
                    <ComboBox fx:id="searchGenereCombo" prefWidth="90" promptText="Genere" style="-fx-base: #333333;"/>
                    <ComboBox fx:id="searchTagCombo" prefWidth="100" promptText="Tag" style="-fx-base: #333333;"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button fx:id="resetSearchBtn" prefWidth="80" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-border-color: #555555; -fx-border-radius: 4;" text="Azzera"/>
                  </HBox>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 8 32 8 32; -fx-border-color: transparent transparent #282828 transparent; -fx-border-width: 0 0 1 0;">
                  <Label maxWidth="30" minWidth="30" prefWidth="30" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="#"/>
                  <Label fx:id="lblHeaderTitolo" maxWidth="160" minWidth="160" prefWidth="160" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="TITOLO"/>
                  <Label fx:id="lblHeaderAutore" maxWidth="120" minWidth="120" prefWidth="120" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="AUTORE"/>
                  <Label fx:id="lblHeaderAnno" maxWidth="50" minWidth="50" prefWidth="50" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="ANNO"/>
                  <Label fx:id="lblHeaderGenere" maxWidth="90" minWidth="90" prefWidth="90" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="GENERE"/>
                  <Label fx:id="lblHeaderTag" maxWidth="100" minWidth="100" prefWidth="100" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="TAG"/>
                  <Pane HBox.hgrow="ALWAYS"/>
                  <Label maxWidth="50" minWidth="50" prefWidth="50" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="🕒"/>
                  <Label maxWidth="20" minWidth="20" prefWidth="20"/>
                </HBox>
                <ListView fx:id="songListView" style="-fx-background-color: #121212; -fx-control-inner-background: #121212; -fx-border-color: transparent;" VBox.vgrow="ALWAYS"/>
              </VBox>
            </content>
          </ScrollPane>
        </VBox>
        <VBox fx:id="viewCreazione" alignment="CENTER" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #0d2318 0%, #121212 35%);" visible="false">
          <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
              <VBox alignment="CENTER" spacing="0" style="-fx-padding: 60 48 60 48;">
                <VBox alignment="CENTER" maxWidth="500" spacing="30" style="-fx-background-color: #121212; -fx-padding: 40; -fx-background-radius: 12; -fx-border-color: #333333; -fx-border-radius: 12; -fx-border-width: 1;">
                  <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="lblGestionePlaylistTitle" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;" text="Nuova Playlist"/>
                  </VBox>
                  <VBox spacing="16">
                    <VBox spacing="6">
                      <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="NOME PLAYLIST"/>
                      <TextField fx:id="playlistNameField" promptText="Es. Le mie preferite" style="-fx-background-color: #1e1e1e; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #333333; -fx-border-radius: 8; -fx-border-width: 1;"/>
                    </VBox>
                  </VBox>
                  <HBox alignment="CENTER" spacing="16" style="-fx-padding: 8 0 0 0;">
                    <Button fx:id="btnAnnullaCreazione" style="-fx-background-color: transparent; -fx-text-fill: #a7a7a7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 24; -fx-border-color: #444444; -fx-border-radius: 30; -fx-border-width: 1; -fx-background-radius: 30;" text="Annulla"/>
                    <Button fx:id="createPlaylistBtn" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 30; -fx-padding: 12 40; -fx-cursor: hand;" text="SALVA"/>
                  </HBox>
                </VBox>
              </VBox>
            </content>
          </ScrollPane>
        </VBox>
        <VBox fx:id="viewSelezionePlaylist" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #0d2318 0%, #121212 35%);" visible="false">
          <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
              <VBox spacing="24" style="-fx-padding: 36 48 36 48;">
                <VBox spacing="6">
                  <Label style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;" text="Aggiungi alla Playlist"/>
                  <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 14px;" text="Seleziona la playlist di destinazione."/>
                </VBox>
                <ListView fx:id="playlistSelectionListView" maxHeight="400" prefHeight="300" style="-fx-background-color: #1e1e1e; -fx-control-inner-background: #1e1e1e; -fx-border-color: transparent; -fx-background-radius: 8; -fx-padding: 8;"/>
                <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 8 0 0 0;">
                  <Button fx:id="btnAnnullaSelezione" style="-fx-background-color: transparent; -fx-text-fill: #a7a7a7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 24; -fx-border-color: #444444; -fx-border-radius: 30; -fx-border-width: 1; -fx-background-radius: 30;" text="Annulla"/>
                  <Button fx:id="btnConfermaSelezione" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 30; -fx-padding: 12 40; -fx-cursor: hand;" text="AGGIUNGI BRANO"/>
                </HBox>
              </VBox>
            </content>
          </ScrollPane>
        </VBox>
        <VBox fx:id="viewSelezioneBrano" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #0d2318 0%, #121212 35%);" visible="false">
          <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
              <VBox spacing="24" style="-fx-padding: 24 24 24 24;" VBox.vgrow="ALWAYS">
                <VBox alignment="CENTER" spacing="6">
                  <Label fx:id="lblSelezioneBranoTitle" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;" text="Aggiungi Brani"/>
                  <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 14px;" text="Seleziona il brano da inserire nella playlist."/>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                  <TextField fx:id="addSearchTitoloField" prefWidth="120" promptText="Titolo..." style="-fx-background-color: #333333; -fx-text-fill: #ffffff;"/>
                  <TextField fx:id="addSearchAutoreField" prefWidth="120" promptText="Autore..." style="-fx-background-color: #333333; -fx-text-fill: #ffffff;"/>
                  <ComboBox fx:id="addSearchAnnoCombo" prefWidth="80" promptText="Anno" style="-fx-base: #333333;"/>
                  <ComboBox fx:id="addSearchGenereCombo" prefWidth="90" promptText="Genere" style="-fx-base: #333333;"/>
                  <ComboBox fx:id="addSearchTagCombo" prefWidth="100" promptText="Tag" style="-fx-base: #333333;"/>
                  <Pane HBox.hgrow="ALWAYS"/>
                  <Button fx:id="addResetSearchBtn" prefWidth="80" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-border-color: #555555; -fx-border-radius: 4;" text="Azzera"/>
                </HBox>
                <VBox spacing="0" style="-fx-background-color: #1e1e1e; -fx-background-radius: 8; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                  <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 8 24 8 24; -fx-border-color: transparent transparent #282828 transparent; -fx-border-width: 0 0 1 0;">
                    <Label maxWidth="30" minWidth="30" prefWidth="30" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="#"/>
                    <Label maxWidth="160" minWidth="160" prefWidth="160" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="TITOLO"/>
                    <Label maxWidth="120" minWidth="120" prefWidth="120" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="AUTORE"/>
                    <Label maxWidth="50" minWidth="50" prefWidth="50" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="ANNO"/>
                    <Label maxWidth="90" minWidth="90" prefWidth="90" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="GENERE"/>
                    <Label maxWidth="100" minWidth="100" prefWidth="100" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="TAG"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label maxWidth="50" minWidth="50" prefWidth="50" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="🕒"/>
                  </HBox>
                  <ListView fx:id="branoSelectionListView" style="-fx-background-color: transparent; -fx-control-inner-background: #1e1e1e; -fx-border-color: transparent; -fx-padding: 8;" VBox.vgrow="ALWAYS"/>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 8 0 0 0;">
                  <Button fx:id="btnAnnullaSelezioneBrano" style="-fx-background-color: transparent; -fx-text-fill: #a7a7a7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 24; -fx-border-color: #444444; -fx-border-radius: 30; -fx-border-width: 1; -fx-background-radius: 30;" text="Annulla"/>
                  <Button fx:id="btnConfermaSelezioneBrano" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 30; -fx-padding: 12 40; -fx-cursor: hand;" text="AGGIUNGI ALLA PLAYLIST"/>
                </HBox>
              </VBox>
            </content>
          </ScrollPane>
        </VBox>
        <!-- VIEW AGGIUNTA BRANO inline (sostituisce il vecchio popup) -->
        <VBox fx:id="viewAggiuntaBrano" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #0d2318 0%, #121212 35%);" visible="false">
          <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
              <VBox spacing="24" style="-fx-padding: 36 48 36 48;">
                <!-- Header -->
                <VBox spacing="6">
                  <Label fx:id="lblImportTitle" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;" text="Importa brano"/>
                  <Label fx:id="lblImportFilename" style="-fx-text-fill: #1DB954; -fx-font-size: 13px;" text=""/>
                </VBox>
                <!-- Campi base -->
                <VBox spacing="16">
                  <VBox spacing="6">
                    <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="TITOLO"/>
                    <TextField fx:id="importTitleField" promptText="Titolo del brano" style="-fx-background-color: #1e1e1e; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #333333; -fx-border-radius: 8; -fx-border-width: 1;"/>
                  </VBox>
                  <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                      <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="AUTORE"/>
                      <TextField fx:id="importAuthorField" promptText="Nome artista" style="-fx-background-color: #1e1e1e; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #333333; -fx-border-radius: 8; -fx-border-width: 1;"/>
                    </VBox>
                    <VBox prefWidth="140" spacing="6">
                      <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="ANNO"/>
                      <TextField fx:id="importYearField" promptText="es. 2024" style="-fx-background-color: #1e1e1e; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #333333; -fx-border-radius: 8; -fx-border-width: 1;"/>
                    </VBox>
                  </HBox>
                </VBox>
                <!-- Genere — selezione singola con bottoni pill -->
                <VBox spacing="10">
                  <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="GENERE"/>
                  <VBox fx:id="genreContainer"/>
                </VBox>
                <!-- Tag — selezione multipla con bottoni pill -->
                <VBox spacing="10">
                  <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="TAG (selezionabili multipli)"/>
                  <VBox fx:id="tagContainer"/>
                </VBox>
                <!-- Bottoni azione -->
                <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 8 0 0 0;">
                  <Button fx:id="btnAnnullaImport" style="-fx-background-color: transparent; -fx-text-fill: #a7a7a7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 24; -fx-border-color: #444444; -fx-border-radius: 30; -fx-border-width: 1; -fx-background-radius: 30;" text="Annulla"/>
                  <Button fx:id="btnConfermaImport" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 30; -fx-padding: 12 40; -fx-cursor: hand;" text="AGGIUNGI ALLA LIBRERIA"/>
                </HBox>
              </VBox>
            </content>
          </ScrollPane>
        </VBox>
        <ScrollPane fx:id="viewHome" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;" visible="false">
          <content>
            <VBox style="-fx-background-color: linear-gradient(to bottom, #112a1c 0%, #121212 40%);">
              <HBox alignment="TOP_CENTER" style="-fx-padding: 24 24 16 24;">
                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 26px; -fx-font-weight: bold;" text="🏠 Home Page"/>
              </HBox>
              <VBox spacing="10" style="-fx-padding: 0 24 16 24;">
                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold;" text="Top Playlists 🎵"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                  <Button fx:id="btnScrollLeftTop" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18px; -fx-cursor: hand; -fx-font-weight: bold;" text="&lt;"/>
                  <ScrollPane fx:id="scrollTopPlaylists" hbarPolicy="NEVER" minHeight="110" prefHeight="110" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;" vbarPolicy="NEVER" HBox.hgrow="ALWAYS">
                    <HBox fx:id="topPlaylistsBox" spacing="16"/>
                  </ScrollPane>
                  <Button fx:id="btnScrollRightTop" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18px; -fx-cursor: hand; -fx-font-weight: bold;" text="&gt;"/>
                </HBox>
              </VBox>
              <VBox spacing="10" style="-fx-padding: 0 24 16 24;">
                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold;" text="Smart Playlists"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                  <Button fx:id="btnScrollLeftSmart" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18px; -fx-cursor: hand; -fx-font-weight: bold;" text="&lt;"/>
                  <ScrollPane fx:id="scrollSmartPlaylists" hbarPolicy="NEVER" minHeight="110" prefHeight="110" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;" vbarPolicy="NEVER" HBox.hgrow="ALWAYS">
                    <HBox fx:id="smartPlaylistsBox" spacing="16"/>
                  </ScrollPane>
                  <Button fx:id="btnScrollRightSmart" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18px; -fx-cursor: hand; -fx-font-weight: bold;" text="&gt;"/>
