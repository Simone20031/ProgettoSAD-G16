<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicplayer.LibreriaView">
  <center>
    <SplitPane dividerPositions="0.22, 0.75" style="-fx-background-color: #000000; -fx-box-border: transparent; -fx-padding: 0;">
      <VBox maxWidth="300.0" minWidth="220.0" spacing="0" style="-fx-background-color: #000000; -fx-padding: 10 0 10 0;">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 16 20 20 20;">
          <Circle fill="#1DB954" radius="12"/>
          <Label style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold; -fx-font-family: 'Helvetica Neue';" text="SonicWave"/>
        </HBox>
        <VBox spacing="4" style="-fx-padding: 0 10 16 10;">
          <Button fx:id="btnMostraLibreria" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: #1a1a1a; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 16; -fx-cursor: hand; -fx-border-color: transparent;" text="🏠 Libreria Generale"/>
        </VBox>
        <Region maxWidth="Infinity" prefHeight="1" style="-fx-background-color: #282828;">
          <VBox.margin>
            <Insets bottom="12" left="16" right="16"/>
          </VBox.margin>
        </Region>
        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4 20 8 20;">
          <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1.2px;" text="LE TUE PLAYLIST"/>
          <Pane HBox.hgrow="ALWAYS"/>
          <Button fx:id="btnApriCreazione" style="-fx-background-color: transparent; -fx-text-fill: #a7a7a7; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 0 5 0 0;" text="+">
            <tooltip>
              <Tooltip text="Crea nuova playlist"/>
            </tooltip>
          </Button>
        </HBox>
        <ListView fx:id="playlistListView" style="-fx-background-color: #000000; -fx-control-inner-background: #000000; -fx-border-color: transparent;" VBox.vgrow="ALWAYS"/>
      </VBox>
      <StackPane fx:id="contentStack">
        <VBox fx:id="viewLista" style="-fx-background-color: linear-gradient(to bottom, #112a1c 0%, #121212 40%);">
          <HBox alignment="TOP_CENTER" style="-fx-padding: 24 24 16 24;">
            <Label fx:id="mainTitleLabel" style="-fx-text-fill: #ffffff; -fx-font-size: 26px; -fx-font-weight: bold;" text="SonicWave"/>
          </HBox>
          <HBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 0 24 16 24;">
            <Button fx:id="addBtn" alignment="TOP_CENTER" contentDisplay="CENTER" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-padding: 8 20; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand; -fx-border-color: transparent;" text="Importa MP3"/>
          </HBox>
          
          <VBox spacing="10" style="-fx-padding: 0 24 16 24;">

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchTitoloField" promptText="Titolo..." prefWidth="140" style="-fx-background-color: #333333; -fx-text-fill: #ffffff;" />
                <TextField fx:id="searchAutoreField" promptText="Autore..." prefWidth="140" style="-fx-background-color: #333333; -fx-text-fill: #ffffff;" />
                <ComboBox fx:id="searchAnnoCombo" promptText="Anno" prefWidth="90" style="-fx-base: #333333;" />
                <ComboBox fx:id="searchGenereCombo" promptText="Genere" prefWidth="110" style="-fx-base: #333333;" />
                <ComboBox fx:id="searchTagCombo" promptText="Tag" prefWidth="120" style="-fx-base: #333333;" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="resetSearchBtn" text="Azzera" prefWidth="80" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-border-color: #555555; -fx-border-radius: 4;" />
            </HBox>
          </VBox>

          <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 8 32 8 32; -fx-border-color: transparent transparent #282828 transparent; -fx-border-width: 0 0 1 0;">
            <Label minWidth="40" prefWidth="40" maxWidth="40" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="#"/>
            <Label minWidth="280" prefWidth="280" maxWidth="280" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="TITOLO"/>
            <Label minWidth="180" prefWidth="180" maxWidth="180" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="AUTORE"/>
            <Label minWidth="120" prefWidth="120" maxWidth="120" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="GENERE"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label minWidth="60" prefWidth="60" maxWidth="60" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px; -fx-font-weight: bold;" text="🕒"/>
            <Label minWidth="20" prefWidth="20" maxWidth="20"/>
          </HBox>
          <ListView fx:id="songListView" style="-fx-background-color: #121212; -fx-control-inner-background: #121212; -fx-border-color: transparent;" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox fx:id="viewCreazione" alignment="CENTER" spacing="30" style="-fx-background-color: #121212; -fx-padding: 50;" visible="false">
          <VBox alignment="CENTER" spacing="10">
            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 32px; -fx-font-weight: bold;" text="Crea una nuova playlist"/>
            <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 14px;" text="Dai un nome alla tua collezione musicale."/>
          </VBox>
          <TextField fx:id="playlistNameField" maxWidth="400" promptText="Nome della playlist" style="-fx-background-color: #333333; -fx-text-fill: #ffffff; -fx-font-size: 16px; -fx-padding: 12; -fx-background-radius: 8;"/>
          <HBox alignment="CENTER" spacing="15">
            <Button fx:id="btnAnnullaCreazione" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-cursor: hand;" text="Annulla"/>
            <Button fx:id="createPlaylistBtn" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 30; -fx-padding: 12 40; -fx-cursor: hand;" text="CREA"/>
          </HBox>
        </VBox>
        <VBox fx:id="viewSelezionePlaylist" alignment="CENTER" spacing="20" style="-fx-background-color: #121212; -fx-padding: 40;" visible="false">
          <Label style="-fx-text-fill: #ffffff; -fx-font-size: 24px; -fx-font-weight: bold;" text="Aggiungi a playlist"/>
          <ListView fx:id="playlistSelectionListView" maxWidth="400" maxHeight="300" style="-fx-background-color: #1e1e1e; -fx-control-inner-background: #1e1e1e; -fx-border-color: transparent;"/>
          <HBox alignment="CENTER" spacing="15">
            <Button fx:id="btnAnnullaSelezione" style="-fx-background-color: transparent; -fx-text-fill: #ffffff;" text="Annulla"/>
            <Button fx:id="btnConfermaSelezione" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-font-weight: bold;" text="AGGIUNGI"/>
          </HBox>
        </VBox>
        <!-- VIEW AGGIUNTA BRANO inline (sostituisce il vecchio popup) -->
        <VBox fx:id="viewAggiuntaBrano" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #0d2318 0%, #121212 35%);" visible="false">
          <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
              <VBox spacing="24" style="-fx-padding: 36 48 36 48;">
                <!-- Header -->
                <VBox spacing="6">
                  <Label fx:id="lblImportTitle" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold;" text="Importa brano"/>
                  <Label fx:id="lblImportFilename" style="-fx-text-fill: #1DB954; -fx-font-size: 13px;" text=""/>
                </VBox>
                <!-- Campi base -->
                <VBox spacing="16">
                  <VBox spacing="6">
                    <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="TITOLO"/>
                    <TextField fx:id="importTitleField" promptText="Titolo del brano"
                                                                                                style="-fx-background-color: #1e1e1e; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #333333; -fx-border-radius: 8; -fx-border-width: 1;" />
                  </VBox>
                  <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                      <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="AUTORE"/>
                      <TextField fx:id="importAuthorField" promptText="Nome artista"
                                                                                                          style="-fx-background-color: #1e1e1e; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #333333; -fx-border-radius: 8; -fx-border-width: 1;" />
                    </VBox>
                    <VBox spacing="6" prefWidth="140">
                      <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="ANNO"/>
                      <TextField fx:id="importYearField" promptText="es. 2024"
                                                                                                          style="-fx-background-color: #1e1e1e; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #333333; -fx-border-radius: 8; -fx-border-width: 1;" />
                    </VBox>
                  </HBox>
                </VBox>
                <!-- Genere — selezione singola con bottoni pill -->
                <VBox spacing="10">
                  <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="GENERE"/>
                  <VBox fx:id="genreContainer"/>
                </VBox>
                <!-- Tag — selezione multipla con bottoni pill -->
                <VBox spacing="10">
                  <Label style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px; -fx-font-weight: bold;" text="TAG (selezionabili multipli)"/>
                  <VBox fx:id="tagContainer"/>
                </VBox>
                <!-- Bottoni azione -->
                <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 8 0 0 0;">
                  <Button fx:id="btnAnnullaImport" style="-fx-background-color: transparent; -fx-text-fill: #a7a7a7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 24; -fx-border-color: #444444; -fx-border-radius: 30; -fx-border-width: 1; -fx-background-radius: 30;" text="Annulla"/>
                  <Button fx:id="btnConfermaImport" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 30; -fx-padding: 12 40; -fx-cursor: hand;" text="AGGIUNGI ALLA LIBRERIA"/>
                </HBox>
              </VBox>
            </content>
          </ScrollPane>
        </VBox>
      </StackPane>
      <VBox maxWidth="350.0" minWidth="250.0" spacing="16" style="-fx-background-color: #121212; -fx-padding: 24 20 24 20; -fx-border-color: transparent transparent transparent #282828; -fx-border-width: 0 0 0 1;">
        <Label alignment="TOP_CENTER" prefHeight="20.0" prefWidth="262.0" style="-fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold;" text="Dettagli Brano" textAlignment="CENTER"/>
        <StackPane style="-fx-padding: 8 0 8 0;">
          <Rectangle arcHeight="12" arcWidth="12" height="180" style="-fx-fill: #282828;" width="180"/>
          <Label style="-fx-font-size: 40px;" text="🎵"/>
        </StackPane>
        <ScrollPane fitToWidth="true" prefHeight="381.0" prefWidth="256.0" style="-fx-background: #121212; -fx-background-color: transparent; -fx-border-color: transparent;">
          <content>
            <Label fx:id="detailsLabel" alignment="TOP_CENTER" mnemonicParsing="true" prefHeight="375.0" prefWidth="259.0" style="-fx-text-fill: #b3b3b3; -fx-font-size: 13px; -fx-line-spacing: 6px;" text="Nessun brano selezionato." wrapText="true"/>
          </content>
        </ScrollPane>
      </VBox>
    </SplitPane>
  </center>

  <bottom>
    <VBox style="-fx-background-color: #181818; -fx-border-color: #282828 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
      <HBox alignment="CENTER" spacing="10" style="-fx-padding: 5 20 0 20;">
        <Label fx:id="currentTimeLabel" style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px;" text="0:00"/>
        <Slider fx:id="progressSlider" max="100" min="0" style="-fx-background-color: transparent; -fx-accent: #1DB954; -fx-cursor: hand;" value="0" HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalTimeLabel" style="-fx-text-fill: #a7a7a7; -fx-font-size: 11px;" text="0:00"/>
      </HBox>
      <HBox alignment="CENTER" style="-fx-padding: 14 18 14 18; -fx-min-height: 64;">
        <VBox alignment="CENTER_LEFT" maxWidth="321.0" minWidth="186.0" prefHeight="42.0" prefWidth="317.0">
          <Label fx:id="playingTitleLabel" alignment="TOP_LEFT" maxWidth="255.0" prefHeight="19.0" prefWidth="248.0" style="-fx-text-fill: #ffffff; -fx-font-size: 13px; -fx-font-weight: bold;" text="Nessun brano" textOverrun="ELLIPSIS"/>
          <Label fx:id="playingAuthorLabel" alignment="TOP_LEFT" maxWidth="232.0" prefHeight="16.0" prefWidth="232.0" style="-fx-text-fill: #727272; -fx-font-size: 11px;" text="in riproduzione" textOverrun="ELLIPSIS"/>
          <Label fx:id="nextSongLabel" alignment="TOP_LEFT" maxWidth="232.0" prefHeight="16.0" prefWidth="232.0" style="-fx-text-fill: #1DB954; -fx-font-size: 11px; -fx-font-weight: bold;" text="" textOverrun="ELLIPSIS"/>
          <opaqueInsets>
            <Insets/>
          </opaqueInsets>
        </VBox>
        <HBox alignment="CENTER" prefHeight="42.0" prefWidth="714.0" spacing="16">
          <Button fx:id="shuffleBtn" alignment="CENTER" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-cursor: hand;" text="🔀" textAlignment="CENTER">
            <font>
              <Font size="18.0"/>
            </font>
          </Button>
          
          <Button fx:id="playBtn" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-background-radius: 50%; -fx-min-width: 42; -fx-min-height: 42; -fx-cursor: hand;" text="▶" textAlignment="CENTER">
            <font>
              <Font size="19.0"/>
            </font>
          </Button>

          <Button fx:id="stopBtn" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-background-radius: 50%; -fx-min-width: 42; -fx-min-height: 42; -fx-cursor: hand;" text="⏹" textAlignment="CENTER"/>
          
          <Button fx:id="loopBtn" alignment="CENTER" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-cursor: hand;" text="🔁" textAlignment="CENTER">
            <font>
              <Font size="18.0"/>
            </font>
          </Button>
        </HBox>
        <HBox alignment="CENTER_RIGHT" minWidth="67.0" prefHeight="42.0" prefWidth="338.0">
          <Label style="-fx-text-fill: #727272; -fx-font-size: 12px;" text="🔊 Vol"/>
        </HBox>
      </HBox>
    </VBox>
  </bottom>
</BorderPane>
