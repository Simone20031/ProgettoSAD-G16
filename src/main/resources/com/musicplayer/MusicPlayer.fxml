<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicplayer.LibreriaView" spacing="8">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12" />
    </padding>
    
    <Label fx:id="mainTitleLabel" text="SonicWave — Gestione brani" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    
    <HBox spacing="8">
        <ListView fx:id="songListView" prefWidth="420" prefHeight="320" />
        
        <VBox spacing="8">
            <Button fx:id="addBtn" text="Importa da file" prefWidth="200" />
            <Button fx:id="editBtn" text="Modifica" prefWidth="200" />
            <Button fx:id="deleteBtn" text="Elimina brano" prefWidth="200" />
          
            <Separator />
            
            <HBox spacing="6" alignment="CENTER">
                <Button fx:id="playBtn" text="Play" prefWidth="60" />
                <Button fx:id="pauseBtn" text="Pause" prefWidth="60" />
                <Button fx:id="stopBtn" text="Stop" prefWidth="60" />
            </HBox>
            
            <Slider fx:id="progressSlider" prefWidth="200" />
            
            <Separator />
            
            <Label text="Playlists" style="-fx-font-weight: bold;" />
            <ListView fx:id="playlistListView" prefWidth="200" prefHeight="100" />
            <HBox spacing="8">
                <TextField fx:id="playlistNameField" promptText="Nome playlist" prefWidth="130" />
                <Button fx:id="createPlaylistBtn" text="Crea" />
            </HBox>
        </VBox>
    </HBox>
    
    <Label fx:id="detailsLabel" text="Seleziona un brano per i dettagli." wrapText="true" />
</VBox>